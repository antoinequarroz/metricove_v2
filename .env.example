# Mot de passe pour accéder à l'app. Sans lui, l'app est ouverte à tous.
APP_PASSWORD=

# Jeton pour les scripts (Hermes, Claude Code) : header "Authorization: Bearer <API_TOKEN>" sur /api.
API_TOKEN=

# demo (aucune publication réelle), treg (recommandé) ou postiz
PUBLISHER=demo

# Adresse publique de Metricove : Instagram, Facebook et Co. y téléchargent les vidéos
# par des liens signés qui expirent (voir docs/TREG.md).
PUBLIC_URL=https://social.antoinequarroz.ch

# treg : un jeton d'agent par équipe treg (une équipe = un compte par réseau).
# Format : nom:jeton,nom2:jeton2   (ou TREG_TOKEN=jeton pour une seule équipe)
TREG_TOKENS=

# Postiz auto-hébergé : URL de l'API publique et clé (Réglages > API dans Postiz)
POSTIZ_URL=https://postiz.antoinequarroz.ch/api/public/v1
POSTIZ_API_KEY=

# Dossier de la base SQLite et des vidéos
DATA_DIR=./data

# Dossier surveillé : chaque vidéo déposée ici (par Claude Code) est importée.
# Un fichier video.json à côté de video.mp4 peut donner le texte, les comptes et la date.
INBOX_DIR=

# Remplir la base avec des données de démo au premier lancement (seulement en mode demo)
SEED_DEMO=true

# Hermes Agent (API server, voir docs/HERMES.md)
HERMES_URL=
HERMES_API_KEY=
